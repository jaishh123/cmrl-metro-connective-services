# Copy this file to ".env" and fill in the two values from Supabase:
# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Use the "anon public" key. NEVER paste the "service_role" key anywhere in this project.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
